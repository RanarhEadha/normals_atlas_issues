[bootstrap]
main_collection = /main/manager/manager.collectionc
render = /main/render/game.renderc

[script]
shared_state = 1

[display]
width = 1920
height = 1080
high_dpi = 1

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch

[project]
title = ProcGen_tryouts
publisher = Make it a Triple
developer = Jennifer S. Lange
version = 0.8
dependencies#0 = https://github.com/subsoap/defos/archive/refs/tags/v2.8.7.zip
dependencies#1 = https://github.com/britzl/defold-orthographic/archive/refs/tags/3.6.2.zip
dependencies#2 = https://github.com/defold/extension-steam/archive/refs/tags/1.14.0.zip
dependencies#3 = https://github.com/defold/extension-fmod/archive/refs/tags/v0.1.0.zip

[input]
game_binding = /input/all.input_bindingc

[sprite]
max_count = 1024

