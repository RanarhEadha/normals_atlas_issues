local function get_screen_sizes()
	local _, _, width, height = defos.get_view_size()
	C.set_screen_size(width, height)
end

-- recalculate window after resize
local function window_callback(event, data)
	if event == window.WINDOW_EVENT_RESIZED then
		C.set_screen_size(data.width, data.height)
	end
end

function init(self)
	math.randomseed(os.time()) --random needs to be initialised
	msg.post(".", "acquire_input_focus")

	-- defos.set_fullscreen(true) --requires defOS library
	window.set_listener(window_callback)
	get_screen_sizes()

	--msg.post("#px_studio", "load")
	--msg.post("#px_startup", "load")
	msg.post("#px_main", "load")
end