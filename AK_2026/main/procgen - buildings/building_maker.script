-- make a street
local building_count = 3
local street_gap = 25
local min_building_width = 350
local max_building_width = 850
local min_building_height = 4
local max_building_height = 9


-- mostly rectangular pieces with solid interiors
local buildings_solid_walls = {
	"buildings_walls (21)",
	"buildings_walls (24)",
	"buildings_walls (34)",
	"buildings_walls (36)",
	"buildings_walls (46)",
	"buildings_walls (47)",
	"buildings_walls (48)",
	"buildings_walls (49)",
	"buildings_walls (50)",
	"buildings_walls (53)",
	"buildings_walls (54)",
	"buildings_walls (55)",
	"buildings_walls (56)",
	"buildings_walls (57)",
	"buildings_walls (58)"
}


-- irregular pieces with lots of transparent space
local buildings_wall_deco = {
	"buildings_walls (7)",
	"buildings_walls (10)",
	"buildings_walls (29)",
	"buildings_walls (39)",
	"buildings_walls (40)",
	"buildings_walls (41)",
	"buildings_walls (42)",
	"buildings_walls (44)",
	"buildings_walls (45)",
}


-- wall layout
local piece_scale = 0.3
local edge_jitter = 65
local solid_overlap_x = 0.6
local solid_overlap_y = 0.4
local max_solid_pieces_per_row = 20
local deco_chance = 0.55
local deco_jitter_ratio = 0.25
-- creates any atlas sprite
local function create_sprite(piece_id, position, scale)
	local id = factory.create("#buildings_factory", position, nil, nil, scale)
	local sprite_url = msg.url(nil, id, "sprite")
	sprite.play_flipbook(sprite_url, hash(piece_id))
	return id
end


----------------------------- windows -----------------------------
local window_pieces = {
	"buildings_windows (7)",
	"buildings_windows (8)",
	"buildings_windows (10)",
}

local window_scale = 0.3
local window_edge_margin_x = 100
local window_edge_margin_y = 100
local window_spacing_x = 160
local window_spacing_y = 180
local window_jitter_x = 12
local window_jitter_y = 8
local window_slot_chance = 0.65

local function create_window(position)
	local piece = window_pieces[math.random(#window_pieces)]
	create_sprite(piece, position, window_scale)
end


local function point_is_on_wall(x, y, wall_rects)
	for _, rect in ipairs(wall_rects) do
		if x >= rect.left and x <= rect.right and y >= rect.bottom and y <= rect.top then
			return true
		end
	end
	return false
end


local function create_windows_for_building(left, right, bottom, top, wall_rects)
	local usable_left = left + window_edge_margin_x
	local usable_right = right - window_edge_margin_x
	local usable_bottom = bottom + window_edge_margin_y
	local usable_top = top - window_edge_margin_y
	if usable_right <= usable_left or usable_top <= usable_bottom then return end

	local y = usable_bottom
	while y <= usable_top do
		local x = usable_left
		while x <= usable_right do
			if math.random() < window_slot_chance then
				local window_x = x + math.random(-window_jitter_x, window_jitter_x)
				local window_y = y + math.random(-window_jitter_y, window_jitter_y)
				if point_is_on_wall(window_x, window_y, wall_rects) then
					create_window(vmath.vector3(window_x, window_y, 0.1))
				end
			end
			x = x + window_spacing_x
		end
		y = y + window_spacing_y
	end
end
------------------------------------- ^ windows --------------------------------------------------


-- get actual dimensions after the atlas image has updated
local function get_piece_size(id)
	local sprite_url = msg.url(nil, id, "sprite")
	local size = go.get(sprite_url, "size")
	return size.x * piece_scale, size.y * piece_scale
end




-- place one dense row between two already chosen edges
local function layout_solid_row(row, row_left, row_right, y_position, top_row, wall_rects, deco_anchors)
	local placements = {}
	local used_ids = {}
	local left_cursor = row_left
	local right_cursor = row_right
	local left_index = 1
	local right_index = #row
	local place_from_left = true
	local row_width = row_right - row_left

	while left_cursor < right_cursor and left_index <= right_index do
		local id

		if place_from_left then
			id = row[left_index]
			left_index = left_index + 1
		else
			id = row[right_index]
			right_index = right_index - 1
		end

		local width, height = get_piece_size(id)

		if width > row_width then
			go.delete(id)
		else
			local piece_left
			local piece_right

			if place_from_left then
				piece_left = left_cursor
				piece_right = piece_left + width
				left_cursor = left_cursor + width * (1 - solid_overlap_x)
			else
				piece_right = right_cursor
				piece_left = piece_right - width
				right_cursor = right_cursor - width * (1 - solid_overlap_x)
			end

			table.insert(placements, {
				id = id,
				width = width,
				height = height,
				left = piece_left,
				right = piece_right
			})

			used_ids[id] = true
			place_from_left = not place_from_left
		end
	end

	for _, id in ipairs(row) do
		if not used_ids[id] then
			go.delete(id)
		end
	end

	local row_height = 0
	for _, piece in ipairs(placements) do
		row_height = math.max(row_height, piece.height)
	end

	for _, piece in ipairs(placements) do
		local wall_x = piece.left + piece.width / 2
		local wall_y = y_position + piece.height / 2

		if top_row then
			wall_y = y_position + row_height - piece.height / 2
		end

		go.set_position(vmath.vector3(wall_x, wall_y, 0), piece.id)

		table.insert(wall_rects, {
			left = piece.left,
			right = piece.right,
			bottom = wall_y - piece.height / 2,
			top = wall_y + piece.height / 2
		})

		table.insert(deco_anchors, {
			x = wall_x,
			y = wall_y,
			width = piece.width,
			height = piece.height
		})
	end

	return row_height
end


-- loose decorative pass over the finished solid facade
local function create_wall_deco(deco_anchors)
	if #buildings_wall_deco == 0 then return end

	for _, anchor in ipairs(deco_anchors) do
		if math.random() < deco_chance then
			local piece = buildings_wall_deco[math.random(#buildings_wall_deco)]
			local jitter_x = (math.random() * 2 - 1) * anchor.width * deco_jitter_ratio
			local jitter_y = math.random() * anchor.height * deco_jitter_ratio
			create_sprite(piece, vmath.vector3(anchor.x + jitter_x, anchor.y + jitter_y, 0.05), piece_scale)
		end
	end
end


local function layout_building(building)
	local origin = building.origin
	local y_position = origin.y
	local building_left = math.huge
	local building_right = origin.x
	local building_top = origin.y
	local wall_rects = {}
	local deco_anchors = {}

	for row_index, row in ipairs(building.pieces) do
		local row_left = origin.x + math.random(0, edge_jitter)
		local row_right = origin.x + building.target_width - math.random(0, edge_jitter)
		local top_row = row_index == #building.pieces

		local row_height = layout_solid_row(row, row_left, row_right, y_position, top_row, wall_rects, deco_anchors)

		building_left = math.min(building_left, row_left)
		building_right = math.max(building_right, row_right)
		building_top = math.max(building_top, y_position + row_height)

		y_position = y_position + row_height * (1 - solid_overlap_y)
	end

	--create_wall_deco(deco_anchors)
	--create_windows_for_building(building_left, building_right, origin.y, building_top, wall_rects)

	return building.target_width
end


-- create enough solid pieces for each row
local function create_building(origin, target_width, height)
	local building = {
		origin = origin,
		target_width = target_width,
		pieces = {}
	}

	for y = 1, height do
		building.pieces[y] = {}

		for x = 1, max_solid_pieces_per_row do
			local piece = buildings_solid_walls[math.random(#buildings_solid_walls)]
			local id = create_sprite(piece, origin, piece_scale)
			building.pieces[y][x] = id
		end
	end

	return building
end


local function create_street(self)
	local origin = go.get_position()
	self.buildings = {}

	for i = 1, building_count do
		local width = math.random(min_building_width, max_building_width)
		local height = math.random(min_building_height, max_building_height)
		self.buildings[i] = create_building(origin, width, height)
	end
end


local function layout_street(self)
	local origin = go.get_position()
	local x_position = origin.x

	for _, building in ipairs(self.buildings) do
		building.origin = vmath.vector3(x_position, origin.y, 0)
		local actual_width = layout_building(building)
		x_position = x_position + actual_width + street_gap
	end
end


function update(self, dt)
	-- required because sprites update later, it's fine to set to false after start and neevr touch again
	if not self.layout_pending then return end
	self.layout_pending = false
	layout_street(self)
end


function init(self)
	print("trying to make street")
	create_street(self)
	self.layout_pending = true
end